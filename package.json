{
  "name": "@norges-domstoler/dds-page-generator",
  "version": "9.0.0",
  "description": "Page Generator",
  "author": "Team Spesial",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/domstolene/page-generator"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "homepage": "https://design.domstol.no",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "build": "tsup --dts",
    "build:fast": "tsup",
    "dev": "pnpm run build:fast -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config eslint.config.mjs --cache",
    "format:check": "prettier --check src --cache",
    "format:write": "prettier --write src --cache",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "pnpm run build && storybook build",
    "serve:storybook": "pnpx serve storybook-static",
    "changeset": "changeset",
    "preinstall": "npx only-allow pnpm",
    "prerelease": "pnpm run build",
    "release": "changeset publish",
    "version:dev": "changeset version --snapshot dev",
    "release:dev": "changeset publish --tag dev"
  },
  "keywords": [
    "page-generator",
    "domstolene",
    "norges domstoler"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@storybook/react": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@navikt/fnrvalidator": "^2.2.0",
    "react-select": "^5.9.0"
  },
  "peerDependencies": {
    "@norges-domstoler/dds-components": "^25.0.0",
    "@norges-domstoler/dds-design-tokens": "^11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
